<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
	xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="stock_bajo" pageWidth="595" pageHeight="842" columnWidth="555"
	leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
	whenNoDataType="AllSectionsNoDetail">

	<parameter name="fechaGeneracion" class="java.lang.String"/>
	<parameter name="cantidadProductos" class="java.lang.String"/>

	<field name="codigo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="stock" class="java.lang.String"/>
	<field name="stockMinimo" class="java.lang.String"/>
	<field name="unidadMedida" class="java.lang.String"/>

	<title>
		<band height="60">
			<staticText>
				<reportElement x="0" y="0" width="555" height="26"/>
				<textElement>
					<font size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[Ferretería San Martín - Productos con Stock Bajo]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="28" width="555" height="16"/>
				<textElement>
					<font size="9" isItalic="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Generado: " + $P{fechaGeneracion} + "   -   Productos activos con stock <= stock mínimo: " + $P{cantidadProductos}]]></textFieldExpression>
			</textField>
		</band>
	</title>

	<columnHeader>
		<band height="20">
			<staticText>
				<reportElement x="0" y="0" width="70" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Código]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="0" width="170" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Descripción]]></text>
			</staticText>
			<staticText>
				<reportElement x="240" y="0" width="90" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Categoría]]></text>
			</staticText>
			<staticText>
				<reportElement x="330" y="0" width="80" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Marca]]></text>
			</staticText>
			<staticText>
				<reportElement x="410" y="0" width="55" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement textAlignment="Right">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Stock]]></text>
			</staticText>
			<staticText>
				<reportElement x="465" y="0" width="55" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement textAlignment="Right">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Mínimo]]></text>
			</staticText>
			<staticText>
				<reportElement x="520" y="0" width="35" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Unidad]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="18" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="70" height="18"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{codigo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="70" y="0" width="170" height="18"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{descripcion}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="240" y="0" width="90" height="18"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{categoria}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="330" y="0" width="80" height="18"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{marca}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="410" y="0" width="55" height="18"/>
				<textElement textAlignment="Right">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{stock}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="465" y="0" width="55" height="18"/>
				<textElement textAlignment="Right">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{stockMinimo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="520" y="0" width="35" height="18"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{unidadMedida}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<noData>
		<band height="40">
			<staticText>
				<reportElement x="0" y="10" width="555" height="20"/>
				<textElement textAlignment="Center">
					<font size="11" isItalic="true"/>
				</textElement>
				<text><![CDATA[No hay productos con stock bajo en este momento.]]></text>
			</staticText>
		</band>
	</noData>

</jasperReport>
