<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
	xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="stock_completo" pageWidth="595" pageHeight="842" columnWidth="555"
	leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
	whenNoDataType="AllSectionsNoDetail">

	<parameter name="fechaGeneracion" class="java.lang.String"/>
	<parameter name="cantidadProductos" class="java.lang.String"/>

	<field name="codigo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="stock" class="java.lang.String"/>
	<field name="unidadMedida" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>

	<title>
		<band height="60">
			<staticText>
				<reportElement x="0" y="0" width="555" height="26"/>
				<textElement>
					<font size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[Ferretería San Martín - Stock Completo (Inventario)]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="28" width="555" height="16"/>
				<textElement>
					<font size="9" isItalic="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Generado: " + $P{fechaGeneracion} + "   -   Total de productos en catálogo: " + $P{cantidadProductos}]]></textFieldExpression>
			</textField>
		</band>
	</title>

	<columnHeader>
		<band height="20">
			<staticText>
				<reportElement x="0" y="0" width="55" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Código]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="0" width="130" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Descripción]]></text>
			</staticText>
			<staticText>
				<reportElement x="185" y="0" width="70" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Categoría]]></text>
			</staticText>
			<staticText>
				<reportElement x="255" y="0" width="60" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Marca]]></text>
			</staticText>
			<staticText>
				<reportElement x="315" y="0" width="45" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement textAlignment="Right">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Stock Sist.]]></text>
			</staticText>
			<staticText>
				<reportElement x="360" y="0" width="55" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Estado]]></text>
			</staticText>
			<staticText>
				<reportElement x="415" y="0" width="75" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement textAlignment="Center">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Conteo Físico]]></text>
			</staticText>
			<staticText>
				<reportElement x="490" y="0" width="65" height="20" mode="Opaque" backcolor="#2B5C7A"/>
				<textElement textAlignment="Center">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Observ.]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="18" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="55" height="18"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{codigo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="55" y="0" width="130" height="18"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{descripcion}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="185" y="0" width="70" height="18"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{categoria}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="255" y="0" width="60" height="18"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{marca}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="315" y="0" width="45" height="18"/>
				<textElement textAlignment="Right">
					<font size="8" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{stock} + " " + $F{unidadMedida}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="360" y="0" width="55" height="18"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{estado}]]></textFieldExpression>
			</textField>
			<!-- Celdas en blanco a propósito: se completan a mano durante el
			     conteo físico del inventario. -->
			<staticText>
				<reportElement x="415" y="0" width="75" height="18"/>
				<box>
					<pen lineWidth="0.5" lineColor="#CCCCCC"/>
				</box>
				<text><![CDATA[]]></text>
			</staticText>
			<staticText>
				<reportElement x="490" y="0" width="65" height="18"/>
				<box>
					<pen lineWidth="0.5" lineColor="#CCCCCC"/>
				</box>
				<text><![CDATA[]]></text>
			</staticText>
		</band>
	</detail>

	<noData>
		<band height="40">
			<staticText>
				<reportElement x="0" y="10" width="555" height="20"/>
				<textElement textAlignment="Center">
					<font size="11" isItalic="true"/>
				</textElement>
				<text><![CDATA[No hay productos cargados en el catálogo.]]></text>
			</staticText>
		</band>
	</noData>

</jasperReport>
