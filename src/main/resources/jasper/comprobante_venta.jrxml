<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
	xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="comprobante_venta" pageWidth="280" pageHeight="800" columnWidth="260"
	leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10"
	whenNoDataType="AllSectionsNoDetail">

	<parameter name="ventaId" class="java.lang.String"/>
	<parameter name="fecha" class="java.lang.String"/>
	<parameter name="cliente" class="java.lang.String"/>
	<parameter name="vendedor" class="java.lang.String"/>
	<parameter name="formaPago" class="java.lang.String"/>
	<parameter name="total" class="java.lang.String"/>
	<parameter name="pagado" class="java.lang.String"/>
	<parameter name="saldo" class="java.lang.String"/>
	<parameter name="mostrarSaldo" class="java.lang.String"/>

	<field name="producto" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.String"/>
	<field name="precioUnitario" class="java.lang.String"/>
	<field name="subtotal" class="java.lang.String"/>

	<title>
		<band height="115">
			<staticText>
				<reportElement x="0" y="0" width="260" height="20"/>
				<textElement textAlignment="Center">
					<font size="13" isBold="true"/>
				</textElement>
				<text><![CDATA[Ferretería San Martín]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="260" height="16"/>
				<textElement textAlignment="Center">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Comprobante de Venta]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="40" width="260" height="1"/>
			</line>
			<textField>
				<reportElement x="0" y="46" width="260" height="14"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["N° Venta: " + $P{ventaId} + "   Fecha: " + $P{fecha}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="60" width="260" height="14"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Cliente: " + $P{cliente}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="74" width="260" height="14"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Vendedor: " + $P{vendedor}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="88" width="260" height="14"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Forma de Pago: " + $P{formaPago}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="106" width="260" height="1"/>
			</line>
		</band>
	</title>

	<columnHeader>
		<band height="16">
			<staticText>
				<reportElement x="0" y="0" width="110" height="16"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Producto]]></text>
			</staticText>
			<staticText>
				<reportElement x="110" y="0" width="30" height="16"/>
				<textElement textAlignment="Right">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Cant.]]></text>
			</staticText>
			<staticText>
				<reportElement x="140" y="0" width="55" height="16"/>
				<textElement textAlignment="Right">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[P. Unit.]]></text>
			</staticText>
			<staticText>
				<reportElement x="195" y="0" width="65" height="16"/>
				<textElement textAlignment="Right">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Subtotal]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="14" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="110" height="14"/>
				<textElement>
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{producto}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="110" y="0" width="30" height="14"/>
				<textElement textAlignment="Right">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cantidad}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="0" width="55" height="14"/>
				<textElement textAlignment="Right">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{precioUnitario}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="195" y="0" width="65" height="14"/>
				<textElement textAlignment="Right">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{subtotal}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<summary>
		<band height="90">
			<line>
				<reportElement x="0" y="4" width="260" height="1"/>
			</line>
			<textField>
				<reportElement x="0" y="10" width="260" height="18"/>
				<textElement textAlignment="Right">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["TOTAL: " + $P{total}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="30" width="260" height="14">
					<printWhenExpression><![CDATA["S".equals($P{mostrarSaldo})]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Pagado: " + $P{pagado}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="44" width="260" height="14">
					<printWhenExpression><![CDATA["S".equals($P{mostrarSaldo})]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Saldo pendiente: " + $P{saldo}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="68" width="260" height="16"/>
				<textElement textAlignment="Center">
					<font size="9" isItalic="true"/>
				</textElement>
				<text><![CDATA[¡Gracias por su compra!]]></text>
			</staticText>
		</band>
	</summary>

</jasperReport>
